//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ML_MAJOR_VERSION,ML_MINOR_VERSION,0,AUTO_BUILD_NUM
 PRODUCTVERSION ML_MAJOR_VERSION,ML_MINOR_VERSION,0,AUTO_BUILD_NUM
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000904b0"
        BEGIN
            VALUE "CompanyName", COMPANY_NAME
            VALUE "FileVersion", ML_VERSION_STR
            VALUE "LegalCopyright", COPYRIGHT
            VALUE "ProductName", PRODUCT_NAME
            VALUE "ProductVersion", ML_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x9, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
