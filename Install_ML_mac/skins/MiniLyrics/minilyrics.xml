<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics"
      Script="minilyrics.java">
  <include Name="Styles.xml"/>
  <DynCmds>
    <cmd ID="dyncmd_is_frame_hide" func="get_profile_bool" param="HideFrameOnLostFocus,1"/>
    <cmd ID="dyncmd_is_mouse_hover_show_frame" func="get_profile_bool" param="ShowFrameOnMouseHover,1"/>

    <cmd ID="CMD_SHOW_LYR"             func="set_ctrl_property"    param="CID_TOGGLE_LYR_PL,CmdToggle,CID_LYRICS" />
    <cmd ID="CMD_SHOW_INFO_TEXT"       func="set_ctrl_property"    param="CID_TOGGLE_LYR_PL,CmdToggle,CID_INFOTEXT" />
  </DynCmds>
  <skinwnd Name="minilyrics" EnableTranslucency="true"
       TranslucencyAlpha="0" TranslucencyAlphaOnHover="228" TranslucencyAlphaOnActive="228"
       MinWidth="330" MinHeight="190" Width="640" Height="240" 
       BgColor="#FFFFFF" ContextMenu="NormalMode" CmdHandler="ch_common">

	<Frame Rect="0,0,w,h" Image="frame-focus.png" ImageRect="0,0,95,95" ImageFocus="frame-focus.png" ImageFocusRect="0,0,95,95" 
		RoundWidthTop="23" RoundWidthBottom="7" ThickWidth="1,1,4,4" BlendPixMode="copy" TranslucencyWithSkin="TRUE"/>

    <DecorativeContainer Name="Caption bar" Rect="0,0,w,23" TranslucencyWithSkin="TRUE">
      <CaptionImage Rect="0,0,w,23" Name="Caption Bg" Image="frame.png" ImageRect="0,0,95,23"
        ImageFocus="frame-focus.png" ImageFocusRect="0,0,95,23" CutPos="20,50,50,80" BlendPixMode="copy"/>

	  <Text ID="ID_CAPTION" Rect="70,3,w-140,17" CaptionText="true" 
		FontName="Verdana" FontHeight="14" FontBold="false" TextColor="#333333" 
		TextOutlinedColor="#000000" TextOutlined="false" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
		 
      <Toolbar ID="CID_TB_SYSBT" Rect="9,5,54,14" TranslucencyWithSkin="TRUE" 
           Image="caption_btn.png" enablehover="TRUE" units_x="14"
           blank_x="-1" blank_cx="14" seperator_x="0" seperator_cx="10"
           MarginX="0" MarginY="0" ButtonSpacesCX="6" FullStatusImage="TRUE">
        <button ID="ID_CLOSE" Left="0" />
        <button ID="ID_MINIMIZE" Left="1" />
      </Toolbar>
    </DecorativeContainer>

    <DecorativeContainer Name="Body" Rect="1,23,w-5,h-23-7" >
	  <LyricsShow Rect="0,0,w,h" EnableToolbar="FALSE" EnableAutoResize="FALSE"/>

      <Container Name="Top control" ID="CID_TOP_CTRL" Rect="0,0,w,24" TranslucencyWithSkin="TRUE">
        <Image Name="Top-ctrl-bg" Rect="0,0,w,24" Image="top-ctrl-bg.png" BltMode="tile" />

		<NormalToolbar Extends="NormalToolbar" Rect="0,0,w,22" />

      </Container>
    </DecorativeContainer>
  
</skinwnd>
</skin>
