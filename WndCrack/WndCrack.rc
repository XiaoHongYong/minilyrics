    DEFPUSHBUTTON   "确定",IDOK,178,7,50,14,WS_GROUP
    LTEXT           "http://www.minilyrics.com",IDC_STATIC,41,40,101,8
    LTEXT           "showbrave@163.com",IDC_STATIC,40,54,69,8
END

IDD_WNDCRACK_DIALOG DIALOGEX 0, 0, 404, 311
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "窗口修改器"
FONT 9, "宋体"
BEGIN
    LTEXT           "拖动下面的图标，到一个窗口中，然后释放，来选择该窗口。",
                    IDC_STATIC,157,7,237,8
    LTEXT           "选择窗口：",IDC_STATIC,158,24,41,8
    LTEXT           "Select Window Position",IDC_SELWND,207,17,22,20
    LTEXT           "窗口句柄：",IDC_STATIC,157,63,41,8
    EDITTEXT        IDC_HWND_CAPTURED,207,60,92,14,ES_AUTOHSCROLL
    PUSHBUTTON      "更新",IDC_UPDATE,348,59,50,14
    LTEXT           "标题：",IDC_STATIC,157,80,25,8
    EDITTEXT        IDC_HWND_CAPTION,207,77,188,14,ES_AUTOHSCROLL
    LTEXT           "类名：",IDC_STATIC,157,99,25,8
    EDITTEXT        IDC_HWND_CLASSNAME,207,95,188,14,ES_AUTOHSCROLL
    GROUPBOX        "窗口位置（相对于屏幕）",IDC_STATIC,157,147,238,51
    LTEXT           "X：",IDC_STATIC,163,162,13,8
    EDITTEXT        IDC_HWND_X,180,159,56,14,ES_AUTOHSCROLL
    LTEXT           "CX：",IDC_STATIC,297,165,17,8
    EDITTEXT        IDC_HWND_CX,325,160,56,14,ES_AUTOHSCROLL
    LTEXT           "Y:",IDC_STATIC,163,181,9,8
    EDITTEXT        IDC_HWND_Y,180,179,56,14,ES_AUTOHSCROLL
    LTEXT           "CY：",IDC_STATIC,297,181,17,8
    EDITTEXT        IDC_HWND_CY,325,179,56,14,ES_AUTOHSCROLL
    GROUPBOX        "修改窗口一般属性",IDC_STATIC,157,203,238,73
    PUSHBUTTON      "显示/隐藏",IDC_SHOWWINDOW,167,216,50,14
    PUSHBUTTON      "顶层/非顶层",IDC_TOPMOST,233,216,50,14
    PUSHBUTTON      "关闭",IDC_CLOSEWND,299,216,50,14
    PUSHBUTTON      "位置/大小",IDC_MOVEWINDOW,167,236,50,14
    PUSHBUTTON      "标题",IDC_SET_WND_CAPTION,233,236,50,14
    PUSHBUTTON      "透明窗口",IDC_SET_WND_OPAQUE,299,236,50,14
    PUSHBUTTON      "最小化/恢复",IDC_MINIMIZE_WND,167,257,50,14
    PUSHBUTTON      "允许/禁止",IDC_ENABLE_WND,233,257,50,14
    CONTROL         "Tree1",IDC_TREE_WND,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | 
                    WS_BORDER | WS_TABSTOP,7,30,140,246
    PUSHBUTTON      "枚举窗口",IDC_ENUM,7,7,50,14
    LTEXT           "Process ID:",IDC_STATIC,157,116,45,8
    EDITTEXT        IDC_E_PROCESSID,208,113,188,14,ES_AUTOHSCROLL
    LTEXT           "Ctrl ID",IDC_STATIC,157,133,29,8
    EDITTEXT        IDC_E_CTRLID,208,131,188,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_MASK_COLOR,207,42,58,14,ES_AUTOHSCROLL
    LTEXT           "Color: ",IDC_STATIC,158,44,29,8
    CONTROL         "Button1",IDC_SEL_COLOR,"Button",BS_OWNERDRAW | BS_FLAT | 
                    WS_TABSTOP,356,42,42,14
    EDITTEXT        IDC_MASK_COLOR2,269,42,80,14,ES_AUTOHSCROLL
END

