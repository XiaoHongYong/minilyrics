IDD_ABOUTBOX DIALOGEX 0, 0, 235, 75
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Window Crack"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "Window Crack 1.0",IDC_STATIC,40,12,119,8,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
    LTEXT           "http://www.crintsoft.com",IDC_STATIC,41,39,97,8
    LTEXT           "support@crintsoft.com",IDC_STATIC,40,54,85,8
END

IDD_WNDCRACK_DIALOG DIALOGEX 0, 0, 402, 313
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Window Crack"
FONT 8, "MS Shell Dlg", 400, 0, 0x86
BEGIN
    LTEXT           "Drag the icon below, and release it to select the target window.",IDC_STATIC,148,6,247,10
    LTEXT           "Select window:",IDC_STATIC,158,24,57,8
