    GROUPBOX        "Modify window Properties",IDC_STATIC,157,225,238,73
    PUSHBUTTON      "Show/Hide",IDC_SHOWWINDOW,165,238,67,14
    PUSHBUTTON      "Top Most/Normal",IDC_TOPMOST,245,238,67,14
    PUSHBUTTON      "Close",IDC_CLOSEWND,322,238,67,14
    PUSHBUTTON      "Position && Size",IDC_MOVEWINDOW,165,258,67,14
    PUSHBUTTON      "Caption",IDC_SET_WND_CAPTION,245,258,67,14
    PUSHBUTTON      "Transparent",IDC_SET_WND_OPAQUE,322,258,67,14
    PUSHBUTTON      "Minimize/Restore",IDC_MINIMIZE_WND,165,279,67,14
    PUSHBUTTON      "Enable/Disable",IDC_ENABLE_WND,322,279,67,14
    CONTROL         "Tree1",IDC_TREE_WND,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | WS_BORDER | WS_HSCROLL | WS_TABSTOP,7,30,140,270
    PUSHBUTTON      "Enum Windows",IDC_ENUM,7,7,69,14
    LTEXT           "Process ID:",IDC_STATIC,157,138,45,8
    EDITTEXT        IDC_E_PROCESSID,207,135,188,14,ES_AUTOHSCROLL
    LTEXT           "Ctrl ID:",IDC_STATIC,157,155,33,8
    EDITTEXT        IDC_E_CTRLID,207,153,188,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_MASK_COLOR,207,42,58,14,ES_AUTOHSCROLL
    LTEXT           "Color: ",IDC_STATIC,158,44,29,8
    CONTROL         "Button1",IDC_SEL_COLOR,"Button",BS_OWNERDRAW | BS_FLAT | WS_TABSTOP,353,42,42,14
    EDITTEXT        IDC_MASK_COLOR2,269,42,80,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Maximize/Restore",IDC_MAXIMIZE_WND,245,279,67,14
    LTEXT           "Parent Window Handle:",IDC_STATIC,155,82,85,8
    EDITTEXT        IDC_HWND_PARENT,244,79,92,14,ES_AUTOHSCROLL
END

IDD_SET_LAYEREDWND_DLG DIALOGEX 0, 0, 273, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Set window transparent"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "Enable transparent settings",IDC_ENABLE_LAYERED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,11,124,10
    EDITTEXT        IDC_MASK_COLOR,160,24,33,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_OPAQUE,160,43,33,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Alter",IDOK,73,83,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,151,83,50,14
    LTEXT           "Static",IDC_SELWND,240,19,26,22
    CONTROL         "Button1",IDC_SEL_COLOR,"Button",BS_OWNERDRAW | BS_FLAT | WS_TABSTOP,198,23,27,14
    CONTROL         "Use Transparent Color:",IDC_C_TRANS_COLOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,26,104,10
    CONTROL         "Use Transparent alpha(0-255):",IDC_R_OPAQUE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,45,132,10
    CONTROL         "Mouse Click Through",IDC_C_CLICKTHROUGH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,64,125,10
END


