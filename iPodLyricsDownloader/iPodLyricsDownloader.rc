IDI_SMALL               ICON                    "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDM_MAIN_WND MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Import &iTunes Library",      ID_IMPORT_ITUNES_LIB
        MENUITEM "Add &Directory...",           ID_ADD_DIR
        MENUITEM "Add &Files...",               ID_ADD_FILES
        MENUITEM SEPARATOR
        MENUITEM "&Clear files list",           ID_CLEAR_LIST
        MENUITEM SEPARATOR
        MENUITEM "&Preferences",                ID_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDC_EXIT
    END
    POPUP "&Lyrics"
    BEGIN
        MENUITEM "&Download All Lyrics",        ID_DOWNLOAD_ALL_LYRICS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&iPod Lyrics Downloader Help", ID_HELP
        MENUITEM "&About ...",                  ID_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
