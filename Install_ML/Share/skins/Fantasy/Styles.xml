<?xml version="1.0" encoding="UTF-8"?>
<styles>
  <style>
    <WindowFrame Name="minilyrics" EnableTranslucency="true" TranslucencyAlpha="245"
         MinWidth="100" MinHeight="100" Width="330" Height="400"
         PaintBg="TRUE" BgColor="#576C91" FgColor="#282828">
      <Image Name="TopLeftCorner" Left="0" Top="0" Width="20" Height="20" Image="frame.png" ImageRect="0, 0, 20, 20" ImageMask="frame-mask.png" ImageMaskRect="0, 0, 20, 20" BlendPixMode="copy"/>
      <Image Name="LeftBottomCorner" Left="0" Top="h-20" Width="20" Height="20" Image="frame.png" ImageRect="0, 55, 20, 20" ImageMask="frame-mask.png" ImageMaskRect="0, 55, 20, 20" BlendPixMode="copy"/>
      <Image Name="BottomBorder" Left="20" Top="h-20+10" Width="w-20-20" Height="20-10" Image="frame.png" ImageRect="20, 65, 35, 10" BltMode="tile" BlendPixMode="copy"/>
      <Image Name="RightBottomCorner" Left="w-20" Top="h-20" Width="20" Height="20" Image="frame.png" ImageRect="55, 55, 20, 20" ImageMask="frame-mask.png" ImageMaskRect="55, 55, 20, 20" BlendPixMode="copy"/>
      <Image Name="TopRightCorner" Left="w-20" Top="0" Width="20" Height="20" Image="frame.png" ImageRect="55, 0, 20, 20" ImageMask="frame-mask.png" ImageMaskRect="55, 0, 20, 20" BlendPixMode="copy"/>
      <Image Name="RightBorder" Left="w-20+10" Top="20" Width="20-10" Height="h-20-20" Image="frame.png" ImageRect="65, 20, 10, 35" BltMode="tile" BlendPixMode="copy"/>
      <Text ID="ID_CAPTION" Rect="30,4,w-60,20" CaptionText="true" FontName="Verdana" FontHeight="16" FontBold="true" TextColor="#FFFFFF" TextOutlinedColor="#000000" TextOutlined="true" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
      <Toolbar ID="CID_TB_SYSBT"  Left="w-15-20" Top="8" Width="20" Height="14"
           UseSkinBg="TRUE" Image="fl_cap_bt.png" enablehover="TRUE" units_x="14"
           blank_x="-1" blank_cx="14" seperator_x="0" seperator_cx="10"
           MarginX="0" MarginY="0" ButtonSpacesCX="2" FullStatusImage="TRUE">
        <button ID="ID_CANCEL" Left="1" />
      </Toolbar>
      <HStretchImage Name="TitleLine" Left="10" Top="25" Width="w-20-10" Height="6" Image="title_line.png" ImageRect="0,0,20,6" StretchStartX="6" StretchEndX="14"/>
      <ClientArea Rect="2, 30, w-4-10, h-30-4"/>
      <WndResizer Name="Bottom" Left="0" Top="h-20" Width="w-20" Height="20" Direction="bottom"/>
      <WndResizer Name="Right" Left="w-20" Top="0" Width="20" Height="h-20" Direction="right"/>
      <WndResizer Name="RightBottom" Left="w-20" Top="h-20" Width="20" Height="20" Direction="right|bottom"/>
    </WindowFrame>
    <NormalText Extends="Text" Height="15" UseSkinBg="true" FontName="Verdana" FontHeight="15" TextColor="#FFFFFF"/>
    <NormalLink Extends="TxtLink" Height="15" UseSkinBg="true" FontName="Verdana" FontHeight="15" TextColor="#FFFF00"/>
    <NormalTextBt Extends="TextButton" FontName="Verdana" FontHeight="15" TextColor="#FFFFFF"
          Height="28" XMargin="5" YMargin="4" UseSkinBg="true" ExtendPos="20,50"
          Image="s_txt_button.png" ImageSize="70,28"
          ImagePos="0,0" ImageSelPos="0,56" ImageFocusPos="0,28"/>
    <NormalEdit Extends="EditCtrl" Height="20" UseSkinBg="true" FontName="Verdana" FontHeight="14" TextColor="#000000"
          XMargin="12" YMargin="8" ExtendPos="20,50" ImageFrame="s_edit_box.png" ImageFrameSize="70,35"
          ImageFramePos="0,35" ImageFrameFocusPos="0,0"/>
    <NormalListCtrl Extends="ListCtrl" BgColor="#FFFFFF,#EDF3FE" SelBgColor="#3875D7" 
          NowPlayBgColor="#5478CA" TextColor="#000000" SelTextColor="#FFFFFF" 
          NowPlayTextColor="#FFFFFF" FontName="Verdana" FontHeight="14"
          HeaderHeight="17" LineColor="#808080" ImageSortedHeader="s_listctrl_sorted_header.png"
          ImageHeader="s_listctrl_header.png" ImageSortFlag="s_listctrl_sort_flag.png"/>
    <WndFrameCaption Extends="Text" ID="ID_CAPTION" Rect="30,4,w-60,20" Text="About MiniLyrics" FontHeight="16" FontBold="true" TextColor="#FFFFFF" TextOutlinedColor="#000000" TextOutlined="true" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
    <CheckBox Image=""/>
    <VScrollBar Width="14" PushBtHeight="14" ThumbHeight="28" TrackHeight="28" ScrollBarWidth="14" Image="vscrollbar.bmp" ScalableThumb="TRUE" />
    <HScrollBar Height="14" PushBtWidth="14" ThumbWidth="28" TrackWidth="28" ScrollBarHeight="14" Image="hscrollbar.bmp" ScalableThumb="TRUE" />
    <ListCtrl BkColor="#4F586E" SelBkColor="#D9D9D9" NowPlayBkColor="#5478CA" TextColor="#FFFFFF" SelTextColor="#4F586E" NowPlayTextColor="#FFFFFF" FontHeight="13"/>
    <CloseButton Extends="Button" Image=""/>
    <MinimizeButton Extends="Button" Image=""/>
  
</style>
