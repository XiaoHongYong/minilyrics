<?xml version="1.0" encoding="UTF-8"?>
<Container.Login ID="CID_C_LOGIN" Name="Login" Rect="0,20,w,h-20" Visible="false">
  <Animation ID="CID_AM_SHOW_LOGIN_F_RIGHT" MoveFromRight="CID_C_LOGIN"/>
  <Animation ID="CID_AM_HIDE_LOGIN_2_LEFT" MoveToLeft="CID_C_LOGIN"/>
  <Animation ID="CID_AM_SHOW_LOGIN_F_LEFT" MoveFromLeft="CID_C_LOGIN"/>

  <NormalText Rect="20,20,w-40,25" FontHeight="20" Text="Thank you for uploading lyrics." AlignText="AT_CENTER"/>
  <NormalText Rect="20,50,w-40," Text="Please login, so you could manage the uploaded lyrics." AlignText="AT_CENTER"/>

  <NormalText Rect="20,80,120," Text="Login Name:" AlignText="AT_RIGHT"/>
  <NormalEdit ID="CID_E_NAME" Rect="140+10,80,w-140-30,"/>

  <NormalText Rect="20,110,120," Text="Password:" AlignText="AT_RIGHT"/>
  <NormalEdit ID="CID_E_PASSWORD" Rect="140+10,110,w-140-30," Style="PASSWORD"/>

  <NormalCheckBox ID="CID_REMEMBER_PWD" Text="Remember password" Rect="140+10,140,w-140-30,"/>

  <NormalLink ID="CID_SIGNUP" Text="Sign up Free, if you don't have an account."
              Rect="20,170,w-40," AlignText="AT_CENTER"/>

  <NormalTextBt ID="ID_OK" Text="OK" Rect="w/2-100-10,200,100,"/>
  <NormalTextBt ID="ID_CANCEL" Text="Cancel" Rect="w/2+10,200,100,"/>
</Container.Login>
