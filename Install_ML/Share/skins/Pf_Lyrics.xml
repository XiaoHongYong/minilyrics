<?xml version="1.0" encoding="UTF-8"?>
<Container ID="CID_C_LYR_ROOT" Name="Lyrics" Rect="0,65,w,h-65" Visible="false">
  <NormalFrame Rect="10,10,w-20,h-20"/>
  <NormalTabButton ID="CID_TOOLBAR_LYR"  Rect="30,10,w-30,">
    <button ID="CMD_LYR_DOWNLOAD" Text="Lyrics Download"/>
    <button ID="CMD_LYR_OUTPUT_PLUGIN" Text="Lyrics Output Plug-ins"/>
  </NormalTabButton>
  <Container Name="Content" Rect="10,0,w-20,h" ClipChildren="true">
    <Container ID="CID_C_LYR_DOWNLOAD" Name="Lyrics Download" Rect="0,30,w,h-30-10">
      <NormalFrame Rect="10,10,w-20,220" Text="Save downloaded lyrics in:"/>
      <NormalRadioBt ID="CID_C_SAVE_IN_SONG_DIR" Text="&amp;Save lyrics in the song's directory" Rect="25,40,w-50,"/>
      <NormalRadioBt ID="CID_C_SAVE_IN_DIR" Text="&amp;Save lyrics in:" Rect="25,70,140,"/>
      <NormalTextBt ID="CID_DOWN_DIR" Text="Choose the directory" Rect="170,70,w-170-15,"/>
      <NormalCheckBox ID="CID_C_SAVE_IN_MP3" Text="&amp;Save lyrics in mp3 file" Rect="25,100,w-50,"/>
      <NormalCheckBox ID="CID_C_ID3V2_SYLT" Text="ID3v2 synchronized Lyrics (Support Windows Media player)"
                      Rect="45,130,w-70,"/>
      <NormalCheckBox ID="CID_C_ID3V2_USLT" Text="ID3v2 unsynchronized Lyrics (Support iTunes, WMP)"
                      Rect="45,160,w-70,"/>
      <NormalCheckBox ID="CID_C_LYR3V2" Text="Lyrics3v2 lyrics (Few players support this format)"
                      Rect="45,190,w-70,"/>
      <NormalFrame Rect="10,230,w-20,100" Text="Rename the downloaded lyrics file name"/>
      <NormalRadioBt ID="CID_C_KEEP_FILENAME" Text="Keep the file name" Rect="25,260,w-50,"/>
      <NormalRadioBt ID="CID_C_AS_SONG_NAME" Text="As the same name as the song" Rect="25,290,w-50,"/>
    </Container>
    <Container ID="CID_C_LYR_OUTPUT_PLUGIN" Name="Lyrics Output Plug-ins" Visible="false" Rect="0,30,w,h-30-10">
      <NormalText Rect="10,20,w-20,40" Text="$Product$ will use the plug-ins below for lyrics output. You can select a plug-in and configure, view about boxes, or uninstall them."/>
      <NormalListCtrl ID="CID_LO_PLUGIN_LIST" Rect="10,60,w-20,h-60-55"
                      EnableHorzScrollBar="false" EnableVertScrollBar="false"/>
      <NormalTextBt ID="CID_CONFIGURE" Text="Configure" Rect="10,h-40,(w-20)/4-20,"/>
      <NormalTextBt ID="CID_ABOUT" Text="About" Rect="10+(w-20)/4,h-40,(w-20)/4-20,"/>
      <NormalTextBt ID="CID_UNINST_PLUG" Text="Uninstall plug-in" Rect="10+(w-20)/2,h-40,(w-20)/4-20,"/>
      <NormalLink ID="CID_GET_PLUG" Text="Get plug-ins" Rect="10+(w-20)*3/4,h-40,(w-20)/4-20," AlignText="AT_CENTER"/>
   </Container>
  </Container>
</Container>
