<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
  </DynCmds>
  <skinwnd Name="floatinglyr" EnableTranslucency="true" TranslucencyAlpha="0" TranslucencyAlphaOnHover="100" TranslucencyAlphaOnActive="228" MinWidth="400" MinHeight="60" Width="400" Height="200" BgColor="#183C7B" ContextMenu="FloatingLyrMode" CmdHandler="ch_floating_lyr" LyrDisplayStylePropName="FloatingLyrDispStyle">
    <LyricsShow Left="0" Top="0" Width="w" Height="h" EnableToolbar="FALSE" EnableAdjustVertAlign="FALSE" EnableStaticTextStyle="FALSE" LyrDisplayStylePropName="FloatingLyrDispStyle" FloatingLyr="1" UseAlbumArtAsBg="FALSE" BlendingLyrText="TRUE" ThickOutline="TRUE"/>
  </skinwnd>
  <skinwnd Name="lyrbar" MinWidth="275" MinHeight="15" Width="400" Height="200" BgColor="#183C7B" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle">
    <LyricsShow Left="0" Top="0" Width="w" Height="h" EnableToolbar="FALSE"
                LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
  </skinwnd>
  <skinwnd Name="minilyrics" MinWidth="275" MinHeight="15" Width="330" Height="400" BgColor="#667280" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow Left="0" Top="0" Width="w" Height="h" EnableToolbar="FALSE" />
  </skinwnd>
</skin>
