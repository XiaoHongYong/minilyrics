<?xml version="1.0" encoding="UTF-8"?>
<skinwnd Extends="MenuWindowFrame" Name="LyricsEditor.xml" Caption="Lyrics Editor" CmdHandler="ch_common"
         MinWidth="640" MinHeight="300" Width="640" Height="400" ContextMenu="NormalMode" Menu="LyrEditorMenu"
         OnCreateCommand="dyncmd_load_toolbar_state" IsDialog="false">
  <Toolbar Left="0" Top="0" Width="22*4+10" Height="26" Image="lyr-tb.bmp"
           enablehover="TRUE" units_x="22" blank_x="858" blank_cx="22" 
           seperator_x="858" seperator_cx="10" MarginX="5" MarginY="3">
    <button ID="ID_INSERTTAG_DOWN" Left="12" Width="2" />
    <button ID="ID_INSERTTAG" Left="14" />
    <button ID="dyncmd_toggle_toolbarex_visible" Left="23" ToolTip="Toggle Extended Toolbar Visible"/>
  </Toolbar>
  <Image Left="22*4+10" Top="0" Width="w-(22*4+10)" Height="26" Name="Toolbar Bg"
         Image="lyr-tb.bmp" ImageRect="858,0,22,26" BltMode="tile"/>
  <Toolbar ID="ID_TOOLBAR" Left="22*4+10" Top="0" Width="w-(22*4+10)" Height="26"
           Image="lyr-tb.bmp" enablehover="TRUE" units_x="22" blank_x="858" blank_cx="22"
           seperator_x="858" seperator_cx="10" MarginX="5" MarginY="3" Visible="false">
    <seperator/>
    <button ID="ID_SEARCH_LYRICS" Left="20" />
    <button ID="ID_NEW_LRC" Left="0" />
    <button ID="ID_OPEN_LRC" Left="1" />
    <button ID="ID_SAVE_LRC" Left="2" />
    <button ID="ID_SAVE_LRC_AS" Left="3" />
    <seperator/>
    <button ID="ID_PLAY" Left="4" />
    <button ID="ID_PAUSE" Left="5" />
    <button ID="ID_BACKWARD" Left="9" />
    <button ID="ID_FORWARD" Left="10" />
    <button ID="ID_JUMP" Left="11" />
    <seperator/>
    <button ID="ID_EDIT_CUT" Left="26" disabled_Left="35" />
    <button ID="ID_EDIT_COPY" Left="27" disabled_Left="36" />
    <button ID="ID_EDIT_PASTE" Left="28" />
    <seperator/>
    <button ID="ID_EDIT_UNDO" Left="29" disabled_Left="37" />
    <button ID="ID_EDIT_REDO" Left="30" disabled_Left="38" />
    <seperator/>
    <button ID="ID_EDIT_FIND" Left="31" />
    <button ID="ID_EDIT_REPLACE" Left="32" />
    <seperator/>
    <button ID="ID_BACKWARD_LYRICS" Left="21" />
    <button ID="ID_FORWARD_LYRICS" Left="22" />
    <seperator/>
    <button ID="ID_EDIT_HELP" Left="24" />
  </Toolbar>
  <BarFrame Name="EditorFrame" ID="CID_EDITOR_FRAME" Rect="0,26,w,h-26-110" XBorder="0" YBorder="0">
    <ContainerBar Name="FindReplace" ID="CID_C_FIND_REPLACE" Visible="false" Width="w" Height="40"
                  MinWidth="w" MinHeight="30" FixedHeight="TRUE" RememberSizePos="false"
                  FixedWidth="TRUE" Align="Top" PaintBg="FALSE">
      <Container Name="Find" ID="CID_C_FIND" Rect="0,0,w,35">
        <NormalTextBt ID="CID_FIND_PREV" Text="Find &amp;Previous" Rect="10,10,100,"/>
        <NormalTextBt ID="CID_FIND_NEXT" Text="Find &amp;Next" Rect="130,10,100,"/>
        <NormalText Text="Find what:" Rect="230,15,100," AlignText="AT_RIGHT | AT_VCENTER"/>
        <NormalEdit ID="CID_E_FIND" Rect="340,13,w-340-120,"/>
        <NormalCheckBox ID="CID_MATCHCASE" Text="Match &amp;case" Rect="w-110,13,90,"/>
      </Container>
      <Container Name="Replace" ID="CID_C_REPLACE" Rect="0,35,w,35">
        <NormalTextBt ID="CID_REPLACE" Text="&amp;Replace" Rect="10,10,100,"/>
        <NormalTextBt ID="CID_REPLACE_ALL" Text="Replace &amp;All" Rect="130,10,100,"/>
        <NormalText Text="Replace with:" Rect="230,15,100," AlignText="AT_RIGHT | AT_VCENTER"/>
        <NormalEdit ID="CID_E_REPLACE" Rect="340,13,w-340-120,"/>
      </Container>
    </ContainerBar>
    <BarFrameClientArea Name="Editor" ID="CID_C_EDITOR" MinWidth="220" MinHeight="104">
      <LyricShowTextEdit Rect="0,0,w,h" />
    </BarFrameClientArea>
  </BarFrame>
  <NormalText Text="Artist:" Rect="10,h-95+5,70," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_ARTIST" Rect="90,h-95,w/2-90,"/>
  <NormalText Text="Edited by:" Rect="w/2,h-95+5,120," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_BY" Rect="w/2+130,h-95,w/2-140,"/>
  
  <NormalText Text="Title:" Rect="10,h-65+5,70," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_TITLE" Rect="90,h-65,w/2-90,"/>
  <NormalText Text="Delay time (ms):" Rect="w/2,h-65+5,120," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_OFFSET" Rect="w/2+130,h-65,w/2-140,"/>
  
  <NormalText Text="Album:" Rect="5,h-35+5,75," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_ALBUM" Rect="90,h-35,w/2-90,"/>
  <NormalText Text="Media length:" Rect="w/2,h-35+5,120," AlignText="AT_RIGHT | AT_VCENTER"/>
  <NormalEdit ID="CID_E_MEDIA_LENGTH" Rect="w/2+130,h-35,w/2-140,"/>
</skinwnd>
