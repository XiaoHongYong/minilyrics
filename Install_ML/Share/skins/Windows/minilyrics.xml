<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr" ExtraResouceFolder="MiniLyrics">
  <style>
    <VScrollBar Extends="VScrollBarOSStyle"/>
    <HScrollBar Extends="HScrollBarOSStyle"/>
  </style>
  <include Name="Styles.xml"/>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
    <cmd ID="dyncmd_toggle_toolbarex_visible" func="multi_cmd" param="dyncmd_do_toggle_toolbarex_visible,dyncmd_save_toolbar_state" />
    <cmd ID="dyncmd_do_toggle_toolbarex_visible" func="toggle_ctrl_visible" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_load_toolbar_state" func="load_ctrl_visible_state" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_save_toolbar_state" func="save_ctrl_visible_state" param="ID_TOOLBAR" />        
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="minilyrics" Caption="MiniLyrics" MinWidth="275" MinHeight="35" Width="400" Height="200" WindowsAppearance="TRUE" BgColor="#E7E7E7" FgColor="#313131" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="0" Top="0" Width="w" Height="h"/>
  </skinwnd>
  <skinwnd Name="lyrbar" MinWidth="150" MinHeight="10" Width="400" Height="200" BgColor="#E7E7E7" FgColor="#313131" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle" IndividualProperties="TRUE">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="0" Top="0" Width="w" Height="h" EnableToolbar="FALSE" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
  </skinwnd>
</skin>