<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
    <cmd ID="dyncmd_toggle_toolbarex_visible" func="multi_cmd" param="dyncmd_do_toggle_toolbarex_visible,dyncmd_save_toolbar_state" />
    <cmd ID="dyncmd_do_toggle_toolbarex_visible" func="toggle_ctrl_visible" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_load_toolbar_state" func="load_ctrl_visible_state" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_save_toolbar_state" func="save_ctrl_visible_state" param="ID_TOOLBAR" />    
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="minilyrics" MinWidth="275" MinHeight="116" Width="400" Height="200" BgColor="#183C7B" FgColor="#FFFFFF" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow Left="5" Top="15" Width="w - 10" Height="h-15 - 4"/>
    <CaptionImage Left="0" Top="0" Width="w" Height="15" Name="Caption" Image="caption.bmp" ImageRect="27,15,295,15" ImageFocus="caption.bmp" ImageFocusRect="27,0,295,15" CutPos="60,135,200,275"/>
    <ActiveButton Left="6" Top="3" Width="18" Height="12" ID="ID_MENU" Name="Menu" Image="caption.bmp" ImageRect="32,18,18,12" ImageSel="caption.bmp" ImageSelRect="32,18,18,12" ImageFocus="caption.bmp" ImageFocusRect="32,3,18,12"/>
    <ActiveButton Left="w - 31" Top="3" Width="9" Height="9" ID="ID_MINIMIZE" Name="Minimize" Image="caption.bmp" ImageRect="292,18,9,9" ImageSel="caption.bmp" ImageSelRect="0,9,9,9" ImageFocus="caption.bmp" ImageFocusRect="292,3,9,9"/>
    <ActiveButton Left="w - 21" Top="3" Width="9" Height="9" ID="dyncmd_change_to_bar" ToolTip="Lyrics Bar" Name="Minimize" Image="caption.bmp" ImageRect="301,18,9,9" ImageSel="caption.bmp" ImageSelRect="9,9,9,9" ImageFocus="caption.bmp" ImageFocusRect="301,3,9,9"/>
    <ActiveButton Left="w - 11" Top="3" Width="9" Height="9" ID="ID_QUIT" Name="Close" Image="caption.bmp" ImageRect="312,18,9,9" ImageSel="caption.bmp" ImageSelRect="18,9,9,9" ImageFocus="caption.bmp" ImageFocusRect="312,3,9,9"/>
    <Image Left="0" Top="15" Width="5" Height="h - 15 - 4" Name="left frame" Image="xframe.bmp" ImageRect="0,15,5,98" BltMode="stretch"/>
    <Image Left="w - 5" Top="15" Width="5" Height="h - 15-4" Name="right frame" Image="xframe.bmp" ImageRect="5,15,5,98" BltMode="stretch"/>
    <XScaleImage Left="0" Top="h-4" Width="w" Height="4" Name="bottom" Image="caption.bmp" ImageRect="27,29,295,4" ImageScaleXStart="50" ImageScaleXEnd="280"/>
  </skinwnd>
  <skinwnd Name="lyrbar" MinWidth="150" MinHeight="20" Width="400" Height="20" BgColor="#183C7B" FgColor="#FFFFFF" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle">
    <LyricsShow Left="3" Top="2" Width="w - 18" Height="h - 5" EnableToolbar="FALSE" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="3" Height="h" Name="left frame" Image="lyr-bar-frame.bmp" ImageRect="0,0,3,38" ImageScaleYStart="2" ImageScaleYEnd="34"/>
    <YScaleImage Left="w - 15" Top="0" Width="15" Height="h" Name="right frame" Image="lyr-bar-frame.bmp" ImageRect="185,0,15,38" ImageScaleYStart="28" ImageScaleYEnd="34"/>
    <Image Left="3" Top="0" Width="w - 18" Height="2" Name="top frame" Image="lyr-bar-frame.bmp" ImageRect="3,0,182,2" BltMode="stretch"/>
    <Image Left="3" Top="h - 3" Width="w - 18" Height="3" Name="bottom frame" Image="lyr-bar-frame.bmp" ImageRect="3,35,182,3" BltMode="stretch"/>
    <ActiveButton Left="w - 11" Top="h/2-4" Width="9" Height="9" ID="ID_CLOSE" Name="Close" Image="lyr-bar-bt.bmp" ImageRect="18,0,9,9" ImageSel="lyr-bar-bt.bmp" ImageSelRect="0,0,9,9" ImageFocus="lyr-bar-bt.bmp" ImageFocusRect="9,0,9,9"/>
  </skinwnd>
</skin>
