<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <style>
    <VScrollBar Width="15" PushBtHeight="18" ThumbHeight="21" TrackHeight="27" ScrollBarWidth="15" Image="vscrollbar.png"/>
    <HScrollBar Height="15" PushBtWidth="18" ThumbWidth="21" TrackWidth="27" ScrollBarHeight="15" Image="hscrollbar.png"/>
  </style>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="lyrbar" Region="lyr-bar.tr2" MinWidth="275" MinHeight="21" Width="250" Height="21" BgColor="#E7E7E7" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle">
    <LyricsShow Left="4" Top="4" Width="w-8-30" Height="h-8" EnableToolbar="FALSE"
       LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="4" Height="h" Name="left frame" Image="lyr-bar.png" ImageRect="0,0,4,21" ImageScaleYStart="4" ImageScaleYEnd="18"/>
    <YScaleImage Left="w-34" Top="0" Width="34" Height="h" Name="right frame" Image="lyr-bar.png" ImageRect="37,0,34,21" ImageScaleYStart="4" ImageScaleYEnd="18"/>
    <Image Left="4" Top="0" Width="w-4-34" Height="4" Name="top frame" Image="lyr-bar.png" ImageRect="4,0,33,4" BltMode="stretch"/>
    <Image Left="4" Top="h-4" Width="w-4-34" Height="4" Name="bottom frame" Image="lyr-bar.png" ImageRect="4,17,33,4" BltMode="stretch"/>
    <Button Left="w-30" Top="4" Width="13" Height="13" ID="ID_SEARCH_LYRICS" Name="search lyrics" Image="lyr-bar.png" ImageRect="72,1,13,13" ImageSel="lyr-bar.png" ImageSelRect="100,1,13,13" ImageFocus="lyr-bar.png" ImageFocusRect="127,1,13,13"/>
    <Button Left="w-16" Top="4" Width="12" Height="12" ID="ID_CLOSE" Name="Quit" Image="caption.png" ImageRect="36,0,12,12" ImageSel="caption.png" ImageSelRect="36,24,12,12" ImageFocus="caption.png" ImageFocusRect="36,12,12,12"/>
  </skinwnd>
  <skinwnd Name="MiniLyrics" Region="caption.tr2" MinWidth="275" MinHeight="116" Width="275" Height="100" BgColor="#E7E7E7" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow Left="12" Top="25" Width="w-24" Height="h-38" EnableAutoResize="TRUE" />
    <CaptionImage Left="0" Top="0" Width="w" Height="25" Name="Caption" Image="caption.png" ImageRect="48,25,349,25" ImageFocus="caption.png" ImageFocusRect="48,0,349,25" CutPos="80,170,245,350"/>
    <Button Left="w-29" Top="4" Width="12" Height="12" ID="ID_QUIT" Name="Quit" Image="caption.png" ImageRect="36,0,12,12" ImageSel="caption.png" ImageSelRect="36,24,12,12" ImageFocus="caption.png" ImageFocusRect="36,12,12,12"/>
    <Button Left="w-44" Top="4" Width="12" Height="12" ID="ID_MINIMIZE" Name="Minimize" Image="caption.png" ImageRect="24,0,12,12" ImageSel="caption.png" ImageSelRect="24,24,12,12" ImageFocus="caption.png" ImageFocusRect="24,12,12,12"/>
    <Button Left="w-59" Top="4" Width="12" Height="12" ID="dyncmd_change_to_bar" Name="lyrics bar" ToolTip="Lyrics Bar" Image="caption.png" ImageRect="12,0,12,12" ImageSel="caption.png" ImageSelRect="12,24,12,12" ImageFocus="caption.png" ImageFocusRect="12,12,12,12"/>
    <Button Left="17" Top="4" Width="12" Height="12" ID="ID_MENU" Name="Menu" Image="caption.png" ImageRect="0,0,12,12" ImageSel="caption.png" ImageSelRect="0,24,12,12" ImageFocus="caption.png" ImageFocusRect="0,12,12,12"/>
    <XScaleImage Left="12" Top="h - 13" Width="w-24" Height="13" Name="centerbottomframe" Image="caption.png" ImageRect="62,50,323,13" ImageScaleXStart="80" ImageScaleXEnd="300"/>
    <YScaleImage Left="0" Top="24" Width="12" Height="h-24" Name="Lframe" Image="XFrame.png" ImageRect="0,0,12,59" ImageScaleYStart="10" ImageScaleYEnd="40" />
    <YScaleImage Left="w-12" Top="24" Width="12" Height="h-24" Name="Rframe" Image="XFrame.png" ImageRect="12,0,12,59" ImageScaleYStart="10" ImageScaleYEnd="40" />
  </skinwnd>
</skin>
