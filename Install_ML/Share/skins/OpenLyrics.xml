<?xml version="1.0" encoding="UTF-8"?>
<skinwnd Extends="WindowFrame" Name="OpenLyrics.xml" Caption="Search lyrics"
         Width="600" Height="400" RememberSizePos="true">
  <Animation ID="CID_AM_SHOW_OPEN_F_RIGHT" MoveFromRight="CID_C_OPEN"
      MoveFromTop="CID_S_AR,CID_E_ARTIST,CID_S_TI,CID_E_TITLE"
      MoveFromBottom="CID_OPEN,CID_MORE,CID_CANCEL"/>
  <Animation ID="CID_AM_HIDE_OPEN_2_LEFT" MoveToLeft="CID_C_OPEN"/>
  <Animation ID="CID_AM_SHOW_OPEN_F_LEFT" MoveFromLeft="CID_C_OPEN"/>
  <Container ID="CID_C_OPEN" Name="Search lyrics" Rect="0,0,w,h">
    <NormalText ID="CID_S_AR" Text="Artist:" Rect="10,20,60,"/>
    <NormalEdit ID="CID_E_ARTIST" Rect="70,20,w-70-20-80-20,"/>
    <NormalText ID="CID_S_TI" Text="Title:" Rect="10,50,60,"/>
    <NormalEdit ID="CID_E_TITLE" Rect="70,50,w-70-20-80-20,"/>
    <NormalTextBt ID="CID_SEARCH" Text="&amp;Search" Rect="w-90-10,50,90,"/>

    <NormalListCtrl ID="CID_L_LYRICS" Rect="10,85,w-20,h-85-45" DrawHeader="true"
         EnableSort="true" DrawBorder="true" ImageList="LyrFileType.png"/>

    <NormalTextBt ID="CID_PREV_PAGE" Visible="false" Text="&lt;&lt; Prev Page" Rect="w-230,h-30-10-20,100,"/>
    <NormalTextBt ID="CID_NEXT_PAGE" Visible="false" Text="Next Page &gt;&gt;" Rect="w-110,h-30-10-20,100,"/>

    <NormalTextBt ID="CID_OPEN" Text="&amp;Open" Rect="w/2-120,h-10-20,100,"/>
    <NormalTextBt ID="CID_MORE" Text="&amp;More &gt;&gt;" Rect="w/2+20,h-10-20,100,"/>
    <NormalTextBt ID="CID_CANCEL" Text="Cancel" Rect="w-110,h-10-20,100,"/>
  </Container>
  <Animation ID="CID_AM_SHOW_RENAME_F_RIGHT" MoveFromRight="CID_C_RENAME"/>
  <Animation ID="CID_AM_HIDE_RENAME_2_RIGHT" MoveToRight="CID_C_RENAME"/>
  <Container ID="CID_C_RENAME" Visible="false" Name="Rename lyrics file" Rect="0,0,w,h">
    <NormalText ID="CID_S_FILENAME" Text="File Name:" Rect="30,h/2-20-20,120,"/>
    <NormalEdit ID="CID_E_FILENAME" Rect="150,h/2-20-20,w-20-150,"/>
    <NormalTextBt ID="ID_OK" Text="OK" Rect="w/2-100-20,h/2+15,100,"/>
    <NormalTextBt ID="ID_CANCEL" Text="Cancel" Rect="w/2+20,h/2+15,100,"/>
  </Container>
  <include Name="WaitMsg.xml"/>
</skinwnd>
