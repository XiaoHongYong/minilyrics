<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="minilyrics" MinWidth="275" MinHeight="116" Width="400" Height="200" BgColor="#D6DBBD" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow Left="2" Top="23" Width="w - 4" Height="h -23 - 8"/>
    <XScaleImage Left="0" Top="0" Width="w" Height="23" ID="ID_NONE" Name="Caption" Image="caption.bmp" ImageRect="0,0,265,23" ImageScaleXStart="80" ImageScaleXEnd="205"/>
    <Button Left="w - 56" Top="5" Width="15" Height="15" ID="ID_MINIMIZE" Name="Minimize" Image="std-buttons.bmp" ImageRect="0,0,15,15" ImageSel="std-buttons.bmp" ImageSelRect="0,15,15,15" ImageFocus="std-buttons.bmp" ImageFocusRect="0,30,15,15"/>
    <Button Left="w - 38" Top="5" Width="15" Height="15" ID="dyncmd_change_to_bar" Name="lyrics bar" ToolTip="Lyrics Bar" Image="std-buttons.bmp" ImageRect="15,0,15,15" ImageSel="std-buttons.bmp" ImageSelRect="15,15,15,15" ImageFocus="std-buttons.bmp" ImageFocusRect="15,30,15,15"/>
    <Button Left="w - 20" Top="5" Width="15" Height="15" ID="ID_QUIT" Name="Quit" Image="std-buttons.bmp" ImageRect="30,0,15,15" ImageSel="std-buttons.bmp" ImageSelRect="30,15,15,15" ImageFocus="std-buttons.bmp" ImageFocusRect="30,30,15,15"/>
    <Toolbar Left="83" Top="2" Width="72" Height="20" Image="button.bmp" enablehover="TRUE" units_x="18" blank_x="0" blank_cx="0">
      <button ID="ID_SEARCH_LYRICS" Left="0" Width="1" Continuous="TRUE"/>
      <button ID="ID_Previous" Left="1" Width="1" Continuous="TRUE"/>
      <button ID="ID_Next" Left="2" Width="1"/>
      <button ID="ID_MENU" Left="3" Width="1"/>
    </Toolbar>
    <Image Left="0" Top="23" Width="2" Height="h - 23 - 8" ID="ID_NONE" Name="Left frame" Image="xframe.bmp" ImageRect="0,23,2,97" BltMode="stretch"/>
    <Image Left="w - 2" Top="23" Width="2" Height="h - 23 - 8" ID="ID_NONE" Name="Right frame" Image="xframe.bmp" ImageRect="2,23,2,97" BltMode="stretch"/>
    <XScaleImage Left="0" Top="h - 8" Width="w" Height="8" ID="ID_NONE" Name="BottomImage" Image="caption.bmp" ImageRect="0,24,265,8" ImageScaleXStart="10" ImageScaleXEnd="255"/>
  </skinwnd>
  <skinwnd Name="lyrbar" MinWidth="150" MinHeight="25" Width="400" Height="200" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle">
    <LyricsShow Left="8" Top="4" Width="w-8-45" Height="h-8" EnableToolbar="FALSE" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="8" Height="h" ID="ID_NONE" Name="Left Frame" Image="lyr-bar-frame.bmp" ImageRect="0,0,8,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <YScaleImage Left="w-45" Top="0" Width="45" Height="h" ID="ID_NONE" Name="Right Frame" Image="lyr-bar-frame.bmp" ImageRect="155,0,45,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <Image Left="8" Top="0" Width="w-8-45" Height="4" ID="ID_NONE" Name="top Frame" Image="lyr-bar-frame.bmp" ImageRect="8,0,148,4" BltMode="stretch"/>
    <Image Left="8" Top="h-4" Width="w-8-45" Height="4" ID="ID_NONE" Name="Bt Frame" Image="lyr-bar-frame.bmp" ImageRect="8,21,148,4" BltMode="stretch"/>
    <Button Left="w-9" Top="h/2-3" Width="7" Height="7" ID="ID_CLOSE" Image="smallbt.bmp" ImageRect="21,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="21,7,7,7"/>
    <Button Left="w-40" Top="h/2-8" Width="12" Height="16" ID="ID_MENU" Name="Menu" Image="buttons.bmp" ImageRect="0,0,16,16" ImageSel="buttons.bmp" ImageSelRect="17,0,16,16" ImageFocus="buttons.bmp" ImageFocusRect="0,17,16,16"/>
    <Button Left="w-26" Top="h/2-8" Width="14" Height="16" ID="ID_NEXT" Name="Next" Image="buttons2.bmp" ImageRect="0,0,16,16" ImageSel="buttons2.bmp" ImageSelRect="17,0,16,16" ImageFocus="buttons2.bmp" ImageFocusRect="0,17,16,16"/>
  </skinwnd>
</skin>
