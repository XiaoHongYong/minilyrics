<?xml version="1.0" encoding="UTF-8"?>
<styles>
  <style>
    <WindowFrame EnableTranslucency="true" TranslucencyAlpha="255"
         MinWidth="100" MinHeight="100" Width="330" Height="400"
         PaintBg="TRUE" BgColor="#576C91" FgColor="#282828" EnableClickThrough="false"
         FontName="Verdana" FontHeight="15" TextColor="#000000">
      <Property Name="BgImage" Image="frame-opaque.png" ImageRect="0,0,458,190"
                HorzExtendPos="230,410" VertExtendPos="70,160"/>

      <Button Left="10" Top="9" Width="16" Height="16" ID="ID_MENU" Name="Menu"
        Image="caption_btn.png" ImageSize="16,16" ImagePos="0,0" ImageSelPos="0,16"
        ImageFocusPos="0,32" UseSkinBg="true" TranslucencyWithSkin="TRUE"/>
      <Text ID="ID_CAPTION" Rect="44,8,w-100,20" CaptionText="true" FontName="Verdana" FontHeight="16" FontBold="true" TextColor="#FFFFFF" TextOutlinedColor="#000000" TextOutlined="true" LeftMargin="0" AlignText="AT_LEFT | AT_VCENTER"/>
      <MenuBar Rect="160,8,w-90-150,18" Name="Menu"
               UseSkinBg="true" TranslucencyWithSkin="TRUE"
         FontHeight="15" FontBold="false" TextColor="#000000" TextOutlinedColor="#FFFFFF"
         TextOutlined="TRUE" TextColorHover="#202020" TextOutlinedColorHover="#FFFFFF"
         TextColorPressed="#FFFFFF" TextOutlinedColorPressed="#000000"
         BgColorPressed="#D0D0D0" BgPressedAlpha="127"/>

      <Toolbar ID="CID_TB_SYSBT" Rect="w-50,10,40,16" TranslucencyWithSkin="TRUE"
           UseSkinBg="TRUE" Image="caption_btn.png" enablehover="TRUE" units_x="16"
           blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
           MarginX="0" MarginY="0" ButtonSpacesCX="5" FullStatusImage="TRUE">
        <button ID="ID_MINIMIZE" Left="1" />
        <button ID="ID_CLOSE" Left="4" />
      </Toolbar>

      <ClientArea Rect="5,31,w-10,h-31-7" ClipChildren="true"/>
    </WindowFrame>
    <PopupWndFrame Name="minilyrics" EnableTranslucency="false"
         FixedWidth="true" FixedHeight="true"
         PaintBg="TRUE" BgColor="#576C91" FgColor="#282828" EnableClickThrough="false">
      <XScaleImage Left="0" Top="0" Width="w" Height="5" Name="Top border"
                   Image="menu_frame.png" ImageRect="0,0,50,5"
                   ImageScaleXStart="10" ImageScaleXEnd="40"/>
      <XScaleImage Left="0" Top="h-5" Width="w" Height="5" Name="Bottom border"
                   Image="menu_frame.png" ImageRect="0,15,50,5"
                   ImageScaleXStart="10" ImageScaleXEnd="40"/>
      <Image Left="0" Top="5" Width="1" Height="h-10" Name="left frame" 
             Image="menu_frame.png" ImageRect="0,5,1,10" BltMode="tile"/>
      <Image Left="w-1" Top="5" Width="1" Height="h-10" Name="left frame"
             Image="menu_frame.png" ImageRect="49,5,1,10" BltMode="tile"/>
      <ClientArea Rect="1, 5, w-2, h-5-5"/>
    </PopupWndFrame>
    <NormalText Extends="Text" Height="15" UseSkinBg="true" FontName="Verdana" FontHeight="15" TextColor="#000000"/>
    <NormalLink Extends="TxtLink" Height="15" UseSkinBg="true" FontName="Verdana" FontHeight="15" TextColor="#0000FF"/>
    <NormalTextBt Extends="TextButton" FontName="Verdana" FontHeight="15" TextColor="#000000" DisabledTextColor="#808080" TabFocus="true"
          Height="28" XMargin="5" YMargin="4" UseSkinBg="true" TextLeftMargin="8" TextRightMargin="8"
          Image="s_txt_button.png" ImageSize="70,28" ExtendPos="20,50"
          ImagePos="0,0" ImageSelPos="0,56" ImageFocusPos="0,28" ImageDisabledPos="0,84"/>
    <NormalImageBt Extends="ImageButton" ContentMarginX="9" ContentMarginY="7"
          Height="28" XMargin="5" YMargin="4" UseSkinBg="true" TabFocus="true"
          Image="s_image_button.png" ImageSize="70,28" ExtendPos="20,50"
          ImagePos="0,0" ImageSelPos="0,56" ImageFocusPos="0,28"/>
    <NormalCheckBox Extends="TextButton" FontName="Verdana" FontHeight="15" TextColor="#000000" DisabledTextColor="#808080"
          Height="20" XMargin="3" YMargin="2" UseSkinBg="true" TextLeftMargin="25" AlignText="AT_LEFT"
          CheckBox="true" TabFocus="true"
          Image="s_checkbox.png" ImageSize="20,20"
          ImagePos="20,0" ImageSelPos="20,20" ImageFocusPos="20,40" ImageDisabledPos="20,60"
          S1_Image="s_checkbox.png" S1_ImageSize="20,20"
          S1_ImagePos="0,0" S1_ImageSelPos="0,20" S1_ImageFocusPos="0,40" S1_ImageDisabledPos="0,60"/>
    <NormalRadioBt Extends="TextButton" FontName="Verdana" FontHeight="15" TextColor="#000000" DisabledTextColor="#808080"
          Height="20" XMargin="3" YMargin="2" UseSkinBg="true" TextLeftMargin="25" AlignText="AT_LEFT"
           Radio="true" TabFocus="true"
          Image="s_radio_button.png" ImageSize="20,20"
          ImagePos="20,0" ImageSelPos="20,20" ImageFocusPos="20,40" ImageDisabledPos="20,60"
          S1_Image="s_radio_button.png" S1_ImageSize="20,20"
          S1_ImagePos="0,0" S1_ImageSelPos="0,20" S1_ImageFocusPos="0,40" S1_ImageDisabledPos="0,60"/>
    <NormalEdit Extends="EditCtrl" Height="19" UseSkinBg="true" FontName="Verdana" FontHeight="14" TextColor="#000000"
          XMargin="12" YMargin="8" ExtendPos="20,50" ImageFrame="s_edit_box.png" ImageFrameSize="70,35"
          ImageFramePos="0,35" ImageFrameFocusPos="0,0"/>
    <NormalListCtrl Extends="ListCtrl" BgColor="#FFFFFF,#EDF3FE" SelBgColor="#3875D7" 
          NowPlayBgColor="#5478CA" TextColor="#000000" SelTextColor="#FFFFFF" 
          NowPlayTextColor="#FFFFFF" FontName="Verdana" FontHeight="14"
          HeaderHeight="17" LineColor="#808080" ImageSortedHeader="s_listctrl_sorted_header.png"
          ImageHeader="s_listctrl_header.png" ImageSortFlag="s_listctrl_sort_flag.png"/>
    <NormalTabButton Extends="TabButton" Height="22" UseSkinBg="TRUE"
          FontName="Verdana" FontHeight="15" TextColor="#000000"
          Image="s_tab_button.png" SperatorLineWidth="1" ButtunBorderWidth="6" 
          MarginX="0" MarginY="0" />
    <NormalComboBox Extends="ComboBox" FontName="Verdana" FontHeight="15" TextColor="#000000" DisabledTextColor="#808080" TabFocus="true"
          Height="28" XMargin="5" YMargin="4" AlignText="AT_LEFT" TextLeftMargin="14" TextRightMargin="30"
          UseSkinBg="true" Image="s_combobox.png" ImageSize="70,28" ExtendPos="20,40"
          ImagePos="0,0" ImageSelPos="0,56" ImageFocusPos="0,28" ImageDisabledPos="0,84"/>
    <NormalFrame Extends="Frame" Image="s_tab_frame.png" RoundWidth="6" ThickWidth="1"
          XBorder="0" YBorder="10" FontName="Verdana" FontHeight="15" TextColor="#000000"/>
    <ListCtrlFrame Extends="Frame" Image="s_listctrl_frame.png" ImageFocus="s_listctrl_frame_focus.png"
          RoundWidth="4" ThickWidth="4" XBorder="0" YBorder="0"/>
    <WndFrameCaption Extends="Text" ID="ID_CAPTION" Rect="30,4,w-60,20" Text="About MiniLyrics" FontHeight="16" FontBold="true" TextColor="#000000" TextOutlinedColor="#000000" TextOutlined="true" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
    <VScrollBar Width="15" PushBtHeight="15" ThumbHeight="20" TrackHeight="20" ScrollBarWidth="15" Image="s_vscrollbar.png" ScalableThumb="TRUE" />
    <HScrollBar Height="15" PushBtWidth="15" ThumbWidth="20" TrackWidth="20" ScrollBarHeight="15" Image="s_hscrollbar.png" ScalableThumb="TRUE" />
    <ListCtrl BkColor="#4F586E" SelBkColor="#D9D9D9" NowPlayBkColor="#5478CA" TextColor="#FFFFFF" SelTextColor="#4F586E" NowPlayTextColor="#FFFFFF" FontHeight="13"/>
    <CloseButton Extends="Button" Image=""/>
    <MinimizeButton Extends="Button" Image=""/>
  </style>
</styles>
