<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <style>
    <VScrollBar Width="14" PushBtHeight="14" ThumbHeight="28" TrackHeight="28" ScrollBarWidth="14" Image="vscrollbar.bmp" ScalableThumb="TRUE" />
    <HScrollBar Height="14" PushBtWidth="14" ThumbWidth="28" TrackWidth="28" ScrollBarHeight="14" Image="hscrollbar.bmp" ScalableThumb="TRUE" />
  </style>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" DynCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" DynCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" DynCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" DynCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="lyrbar" Region="lyr-bar.tr2" MinWidth="275" MinHeight="25" Width="400" Height="200" BgColor="#183C7B" FgColor="#ECECEC" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle" IndividualProperties="TRUE">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="8" Top="4" Width="w-8-25" Height="h-8" EnableToolbar="FALSE" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="8" Height="h" Name="left frame" Image="lyr-bar-frame.bmp" ImageRect="0,0,8,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <YScaleImage Left="w-25" Top="0" Width="25" Height="h" Name="right frame" Image="lyr-bar-frame.bmp" ImageRect="155,0,25,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <Image Left="8" Top="0" Width="w-8-25" Height="4" Name="top frame" Image="lyr-bar-frame.bmp" ImageRect="8,0,147,4" BltMode="stretch"/>
    <Image Left="8" Top="h-4" Width="w-8-25" Height="4" Name="bottom frame" Image="lyr-bar-frame.bmp" ImageRect="8,21,147,4" BltMode="stretch"/>
    <Button Left="w-17" Top="5" Width="11" Height="10" ID="ID_CLOSE" Name="Close" Image="buttons.bmp" ImageRect="33,10,11,10" ImageSel="buttons.bmp" ImageSelRect="33,20,11,10"/>
  </skinwnd>
  <skinwnd Name="minilyrics" MinWidth="275" MinHeight="35" Width="400" Height="200" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="4" Top="14" Width="w - 8" Height="h - 14 - 4"/>
    <ActiveImage Left="0" Top="0" Width="24" Height="14" Name="LeftTopcaption" Image="titlebar.bmp" ImageRect="27,15,24,14" BltMode="copy" ImageFocus="titlebar.bmp" ImageFocusRect="27,0,24,14"/>
    <ActiveImage Left="24" Top="0" Width="w - 64" Height="14" Name="Left2Topcaption" Image="titlebar.bmp" ImageRect="50,15,77,14" BltMode="stretch" ImageFocus="titlebar.bmp" ImageFocusRect="50,0,77,14"/>
    <ActiveImage Left="w - 41" Top="0" Width="41" Height="14" Name="LeftTopImage" Image="titlebar.bmp" ImageRect="261,15,41,14" BltMode="copy" ImageFocus="titlebar.bmp" ImageFocusRect="261,0,41,14"/>
    <ActiveButton Left="6" Top="3" Width="9" Height="9" ID="ID_MENU" Name="Menu" Image="titlebar.bmp" ImageRect="33,18,9,9" ImageSel="titlebar.bmp" ImageSelRect="0,9,9,9" ImageFocus="titlebar.bmp" ImageFocusRect="33,3,9,9"/>
    <ActiveButton Left="w - 31" Top="3" Width="9" Height="9" ID="ID_MINIMIZE" Name="Minimize" Image="titlebar.bmp" ImageRect="271,18,9,9" ImageSel="titlebar.bmp" ImageSelRect="9,9,9,9" ImageFocus="titlebar.bmp" ImageFocusRect="271,3,9,9"/>
    <ActiveButton Left="w - 21" Top="3" Width="9" Height="9" ID="dyncmd_change_to_bar" ToolTip="Lyrics Bar"  Name="Minimize" Image="titlebar.bmp" ImageRect="281,18,9,9" ImageSel="titlebar.bmp" ImageSelRect="9,18,9,9" ImageFocus="titlebar.bmp" ImageFocusRect="281,3,9,9"/>
    <ActiveButton Left="w - 11" Top="3" Width="9" Height="9" ID="ID_QUIT" Name="Minimize" Image="titlebar.bmp" ImageRect="291,18,9,9" ImageSel="titlebar.bmp" ImageSelRect="18,9,9,9" ImageFocus="titlebar.bmp" ImageFocusRect="291,3,9,9"/>
    <YScaleImage Left="0" Top="14" Width="4" Height="h - 14" Name="Left frame" Image="main.bmp" ImageRect="0,14,4,101" ImageScaleYStart="25" ImageScaleYEnd="100"/>
    <YScaleImage Left="w - 4" Top="14" Width="4" Height="h - 14" Name="right frame" Image="main.bmp" ImageRect="271,14,4,101" ImageScaleYStart="25" ImageScaleYEnd="100"/>
    <XScaleImage Left="0" Top="h - 5" Width="w" Height="5" Name="bottom frame" Image="main.bmp" ImageRect="0,111,275,5" ImageScaleXStart="20" ImageScaleXEnd="250"/>
  </skinwnd>
</skin>
