<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics" ExtraResouceFolder="MiniLyrics">
  <include Name="Styles.xml"/>
  <style>
    <VScrollBar Width="14" PushBtHeight="14" ThumbHeight="28" TrackHeight="28" ScrollBarWidth="14" Image="vscrollbar.bmp" ScalableThumb="TRUE" />
    <HScrollBar Height="14" PushBtWidth="14" ThumbWidth="28" TrackWidth="28" ScrollBarHeight="14" Image="hscrollbar.bmp" ScalableThumb="TRUE" />
  </style>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar..." IDCmd="dyncmd_openclose_lyrics_bar" CanCheck="true" IsCheckedCmd="dyncmd_is_lyrics_bar_visible" />
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_openclose_floatinglyr" func="openclose_skin_wnd" param="floatinglyr" />
    <cmd ID="dyncmd_openclose_lyrics_bar" func="openclose_skin_wnd" param="lyrbar" />
    <cmd ID="dyncmd_is_lyrics_bar_visible" func="is_skin_wnd_visible" param="lyrbar" />
    <cmd ID="dyncmd_toggle_toolbarex_visible" func="multi_cmd" param="dyncmd_do_toggle_toolbarex_visible,dyncmd_save_toolbar_state" />
    <cmd ID="dyncmd_do_toggle_toolbarex_visible" func="toggle_ctrl_visible" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_load_toolbar_state" func="load_ctrl_visible_state" param="ID_TOOLBAR" />
    <cmd ID="dyncmd_save_toolbar_state" func="save_ctrl_visible_state" param="ID_TOOLBAR" />
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="MiniLyrics"  MinWidth="275" MinHeight="35" Width="400" Height="200" TagColor="#FF8242" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="0" Top="0" Width="w" Height="h" EnableAutoResize="FALSE"/>
  </skinwnd>
  <skinwnd Name="lyrbar" Region="lyr-bar.tr2" MinWidth="275" MinHeight="25" Width="400" Height="200" BgColor="#183C7B" FgColor="#ECECEC" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle" IndividualProperties="TRUE">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="8" Top="4" Width="w-8-48" Height="h-8" EnableToolbar="FALSE" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="8" Height="h" Name="left frame" Image="lyr-bar-frame.bmp" ImageRect="0,0,8,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <YScaleImage Left="w-48" Top="0" Width="48" Height="h" Name="right frame" Image="lyr-bar-frame.bmp" ImageRect="132,0,48,25" ImageScaleYStart="5" ImageScaleYEnd="20"/>
    <Image Left="8" Top="0" Width="w-8-48" Height="4" Name="top frame" Image="lyr-bar-frame.bmp" ImageRect="8,0,124,4" BltMode="stretch"/>
    <Image Left="8" Top="h-4" Width="w-8-48" Height="4" Name="bottom frame" Image="lyr-bar-frame.bmp" ImageRect="8,21,124,4" BltMode="stretch"/>
    <Button Left="w-17-24" Top="5" Width="11" Height="10" ID="ID_MINIMIZE" Name="MiniMize" Image="buttons.bmp" ImageRect="11,10,11,10" ImageSel="buttons.bmp" ImageSelRect="11,20,11,10"/>
    <Button Left="w-17-12" Top="5" Width="11" Height="10" ID="ID_CLOSE" ToolTip="Normal Mode" Image="buttons.bmp" ImageRect="66,10,11,10" ImageSel="buttons.bmp" ImageSelRect="66,20,11,10"/>
    <Button Left="w-17" Top="5" Width="11" Height="10" ID="ID_CLOSE" Name="Close" Image="buttons.bmp" ImageRect="33,10,11,10" ImageSel="buttons.bmp" ImageSelRect="33,20,11,10"/>
  </skinwnd>
</skin>
