
;--------------------------------
;Include Modern UI

  !include "MUI2.nsh"
  
  ; MLVersion.nsh was generated by script, it should include the following line
  ; !define ML_VERSION	"6.4.212"
  !include "MLVersion.nsh"

  !define TEMP1 $R0 ;Temp variable

;--------------------------------
;General

  ;Name and file
  Name "MiniLyrics ${ML_VERSION}"
  BrandingText "MiniLyrics"
  VIAddVersionKey "ProductName" "MiniLyrics"
  VIAddVersionKey "CompanyName" "Crintsoft"
  VIAddVersionKey "LegalCopyright" "Crintsoft"
  VIAddVersionKey "FileDescription" "Automatic lyrics display for your favorite songs."
  VIAddVersionKey "FileVersion" ${ML_VERSION}
  VIProductVersion "${ML_VERSION}.0"

  OutFile "MiniLyrics.exe"

  XPStyle on

  ;Default installation folder
  InstallDir "$PROGRAMFILES\Minilyrics"

  ;Request application privileges for Windows Vista
  RequestExecutionLevel admin

;--------------------------------
;Interface Settings

  !define MUI_ABORTWARNING

;--------------------------------
;Language Selection Dialog Settings

  ;Remember the installer language
  !define MUI_LANGDLL_REGISTRY_ROOT "HKCU" 
  !define MUI_LANGDLL_REGISTRY_KEY "Software\MiniLyrics" 
  !define MUI_LANGDLL_REGISTRY_VALUENAME "InstallerLanguage"

;--------------------------------
;Pages

  !insertmacro MUI_PAGE_LICENSE "license.txt"
  !insertmacro MUI_PAGE_COMPONENTS
  !insertmacro MUI_PAGE_DIRECTORY
  !insertmacro MUI_PAGE_INSTFILES

  !insertmacro MUI_UNPAGE_CONFIRM
  !insertmacro MUI_UNPAGE_INSTFILES

;--------------------------------
;Languages

  !insertmacro MUI_LANGUAGE "English"
  !insertmacro MUI_LANGUAGE "French"
  !insertmacro MUI_LANGUAGE "German"
  !insertmacro MUI_LANGUAGE "Spanish"
  !insertmacro MUI_LANGUAGE "SimpChinese"
  !insertmacro MUI_LANGUAGE "TradChinese"
  !insertmacro MUI_LANGUAGE "Japanese"
  !insertmacro MUI_LANGUAGE "Italian"
  !insertmacro MUI_LANGUAGE "Dutch"
  !insertmacro MUI_LANGUAGE "Danish"
  !insertmacro MUI_LANGUAGE "Swedish"
  !insertmacro MUI_LANGUAGE "Norwegian"
  !insertmacro MUI_LANGUAGE "Finnish"
  !insertmacro MUI_LANGUAGE "Portuguese"

;--------------------------------
;Reserve Files
  
  ;If you are using solid compression, files that are required before
  ;the actual installation should be stored first in the data block,
  ;because this will make your installer start faster.
  
  !insertmacro MUI_RESERVEFILE_LANGDLL

;--------------------------------
;Language Strings

  ;Descriptions
  LangString DESC_SecBasic ${LANG_ENGLISH} "Basic installation for running MiniLyrics"
  LangString DESC_SecShortcut ${LANG_ENGLISH} "Create start menu and uninstallation program"
  LangString DESC_SecDesktopShortcut ${LANG_ENGLISH} "Create Shortcut on desktop and quick lanuch bar"
  LangString DESC_SecSettingPersonal ${LANG_ENGLISH} "Save MiniLyrics settings in each user's personal folder"
  LangString SecShortcut.MLUninst ${LANG_ENGLISH} "Uninstall MiniLyrics"
  LangString SecShortcut.Homepage ${LANG_ENGLISH} "MiniLyrics' Hopepage"

  LangString un.MsgUnstMLRuning ${LANG_ENGLISH} "MiniLyrics is Running, please close your player, and running uninstall program again."
  LangString un.MsgRemovelAll ${LANG_ENGLISH} "Remove All files in your MiniLyrics directory(Including some setting files)?"

  !include "InstLangFiles\LangDanish.nsh"
  !include "InstLangFiles\LangDutch.nsh"
  !include "InstLangFiles\LangFinnish.nsh"
  !include "InstLangFiles\LangFrench.nsh"
  !include "InstLangFiles\LangGerman.nsh"
