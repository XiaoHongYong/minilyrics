  RMDir "$INSTDIR\ml-winamp2-skin"
  RMDir "$INSTDIR\ml-winamp5-skin"
  RMDir "$INSTDIR\Skins"
  RMDir "$INSTDIR\Patterns"
  RMDir "$INSTDIR\Plugins"
