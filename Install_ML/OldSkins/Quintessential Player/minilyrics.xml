<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="minilyrics" mainwnds="minilyrics,lyrbar,floatinglyr">
  <include Name="Styles.xml"/>
  <style>
    <VScrollBar Width="14" PushBtHeight="14" ThumbHeight="28" TrackHeight="28" ScrollBarWidth="14" Image="vscrollbar.bmp" ScalableThumb="TRUE" />
    <HScrollBar Height="14" PushBtWidth="14" ThumbWidth="28" TrackWidth="28" ScrollBarHeight="14" Image="hscrollbar.bmp" ScalableThumb="TRUE" />
  </style>
  <Menus>
    <Menu Name="NormalMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
    </Menu>
    <Menu Name="LyrBarMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="&amp;Floating Lyrics Mode" IDCmd="dyncmd_change_to_floatinglyr"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
    <Menu Name="FloatingLyrMode" From="MainMenu" >
      <Item Action="Append" Type="item" Name="Lyrics &amp;Bar Mode" IDCmd="dyncmd_change_to_bar"/>
      <Item Action="Append" Type="item" Name="&amp;Normal Mode" IDCmd="dyncmd_change_to_normal"/>
    </Menu>
  </Menus>
  <DynCmds>
    <cmd ID="dyncmd_change_to_bar" func="change_skin_wnd" param="lyrbar"/>
    <cmd ID="dyncmd_change_to_floatinglyr" func="change_skin_wnd" param="floatinglyr"/>
    <cmd ID="dyncmd_change_to_normal" func="change_skin_wnd" param="minilyrics"/>
  </DynCmds>
  <include Name="FloatingLyrMode.xml"/>
  <skinwnd Name="minilyrics" Region="qcd.tr2" MinWidth="245" MinHeight="35" Width="400" Height="200" BgColor="#5A5D5A" FgColor="#FFFFFF" ContextMenu="NormalMode" CmdHandler="ch_common">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="5" Top="22" Width="w - 10" Height="h -22 - 6" BgColor="#5A5D5A" FgColor="#FFFFFF" FgLowColor="#A4A4A4" FocusLineBgColor="#295DEF" TagColor="#FF8242" />
    <CaptionImage Left="0" Top="0" Width="w" Height="22" Name="Caption" Image="caption.bmp" ImageRect="0,0,265,22" ImageFocus="caption.bmp" ImageFocusRect="0,0,265,22" CutPos="92,104,110,115"/>
    <ActiveButton Left="4" Top="4" Width="7" Height="7" ID="ID_MENU" Name="Menu" Image="smallbt.bmp" ImageRect="0,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="0,7,7,7" ImageFocus="smallbt.bmp" ImageFocusRect="0,0,7,7"/>
    <ActiveButton Left="w - 28" Top="3" Width="7" Height="7" ID="ID_MINIMIZE" Name="Minimize" Image="smallbt.bmp" ImageRect="7,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="7,7,7,7" ImageFocus="smallbt.bmp" ImageFocusRect="7,0,7,7"/>
    <ActiveButton Left="w - 20" Top="3" Width="7" Height="7" ID="dyncmd_change_to_bar" Name="lyrics bar" ToolTip="Lyrics Bar" Image="smallbt.bmp" ImageRect="14,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="14,7,7,7" ImageFocus="smallbt.bmp" ImageFocusRect="14,0,7,7"/>
    <ActiveButton Left="w - 12" Top="3" Width="7" Height="7" ID="ID_QUIT" Name="Quit" Image="smallbt.bmp" ImageRect="21,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="21,7,7,7" ImageFocus="smallbt.bmp" ImageFocusRect="21,0,7,7"/>
    <Button Left="w - 122" Top="4" Width="15" Height="15" ID="ID_SEARCH_LYRICS" Image="button.bmp" ImageRect="3,0,15,15" ImageSel="button.bmp" ImageSelRect="3,15,15,15"/>
    <Button Left="w - 122 + 15" Top="4" Width="15" Height="15" ID="ID_BACKWARD_LYRICS" Image="button.bmp" ImageRect="18,0,15,15" ImageSel="button.bmp" ImageSelRect="18,15,15,15" Continuous="TRUE"/>
    <Button Left="w - 122 + 30" Top="4" Width="15" Height="15" ID="ID_FORWARD_LYRICS" Image="button.bmp" ImageRect="33,0,15,15" ImageSel="button.bmp" ImageSelRect="33,15,15,15" Continuous="TRUE"/>
    <Button Left="w - 122 + 45" Top="4" Width="15" Height="15" ID="ID_MENU" Image="button.bmp" ImageRect="48,0,15,15" ImageSel="button.bmp" ImageSelRect="48,15,15,15"/>
    <Image Left="0" Top="22" Width="5" Height="h - 22 - 6" Name="left frame" Image="XFrame.bmp" ImageRect="0,22,5,100" BltMode="stretch"/>
    <Image Left="w - 5" Top="22" Width="5" Height="h - 22 - 6" Name="right frame" Image="XFrame.bmp" ImageRect="5,22,5,100" BltMode="stretch"/>
    <Image Left="0" Top="h - 6" Width="5" Height="6" Name="LeftBottomImage" Image="caption.bmp" ImageRect="0,23,5,6" BltMode="copy"/>
    <Image Left="5" Top="h - 6" Width="w - 10" Height="6" Name="CenterBottomImage" Image="caption.bmp" ImageRect="5,23,255,6" BltMode="stretch"/>
    <Image Left="w - 5" Top="h - 6" Width="5" Height="6" Name="RightBottomImage" Image="caption.bmp" ImageRect="260,23,5,6" BltMode="copy"/>
  </skinwnd>
  <skinwnd Name="lyrbar" MinWidth="150" MinHeight="15" Width="400" Height="200" BgColor="#5A5D5A" FgColor="#FFFFFF" ContextMenu="LyrBarMode" CmdHandler="ch_common" LyrDisplayStylePropName="LyrBarDispStyle" IndividualProperties="TRUE">
    <LyricsShow ID="ID_LYRICS_SHOW" Left="2" Top="2" Width="w - 11 - 2" Height="h - 4" EnableToolbar="FALSE" BgColor="#5A5D5A" FgColor="#FFFFFF" FgLowColor="#A4A4A4" FocusLineBgColor="#295DEF" TagColor="#FF8242" LyrDisplayStylePropName="LyrBarDispStyle" LyrDisplayStyle="LyricShowSingleRow"/>
    <YScaleImage Left="0" Top="0" Width="2" Height="h" Name="left frame" Image="lyr-bar.bmp" ImageRect="0,0,2,20" ImageScaleYStart="2" ImageScaleYEnd="18"/>
    <YScaleImage Left="w - 11" Top="0" Width="11" Height="h" Name="right frame" Image="lyr-bar.bmp" ImageRect="254,0,11,20" ImageScaleYStart="6" ImageScaleYEnd="14"/>
    <Image Left="2" Top="0" Width="w - 11 - 2" Height="2" Name="top frame" Image="lyr-bar.bmp" ImageRect="2,0,252,2" BltMode="stretch"/>
    <Image Left="2" Top="h - 2" Width="w - 11 - 2" Height="2" Name="bottom frame" Image="lyr-bar.bmp" ImageRect="2,18,252,2" BltMode="stretch"/>
    <Button Left="w - 9" Top="h/2-3" Width="7" Height="7" ID="ID_CLOSE" Image="smallbt.bmp" ImageRect="21,0,7,7" ImageSel="smallbt.bmp" ImageSelRect="21,7,7,7"/>
  </skinwnd>
</skin>
