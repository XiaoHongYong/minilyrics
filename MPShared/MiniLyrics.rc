//
// Dialog
//

IDD_COPYSONGLYRICS DIALOG  0, 0, 279, 111
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Copy song file and lyrics to..."
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Source file:",IDC_STATIC,7,11,49,8
    EDITTEXT        IDC_E_SRC,70,9,202,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Target folder:",IDC_STATIC,7,30,51,8
    EDITTEXT        IDC_E_TARGET,70,28,187,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,260,28,12,14
    CONTROL         "copy lyrics",IDC_C_COPYLYRICS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,49,113,10
    CONTROL         "rename lyrics as the same name as the song",IDC_C_RENAMELYRICS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,68,251,10
    DEFPUSHBUTTON   "OK",IDOK,75,90,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,154,90,50,14
END

IDD_CRASH_REPORT DIALOGEX 0, 0, 268, 129
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "$Product$ Crash Report"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "$Product$ has encountered a problem and needs to close. We are sorry for the inconvenience.",IDC_STATIC,19,17,201,24
    DEFPUSHBUTTON   "&Send",IDOK,145,107,50,14
    PUSHBUTTON      "E&xit",IDCANCEL,211,107,50,14
    ICON            IDI_CRASH,IDC_STATIC,226,16,21,20,SS_REALSIZEIMAGE
    LTEXT           "We have created an error report that you can send to us.  We will treat this report as confidential and anonymous.",IDC_STATIC,20,45,230,20
    LTEXT           "Please click 'Send' button, a new mail will be generated, then send this mail to us. It will be very helpful to solve this error.",IDC_STATIC,20,70,230,33
END

IDD_MSG DIALOGEX 0, 0, 268, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Confirm to save the lyrics file"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    PUSHBUTTON      "YES",IDYES,80,73,50,14
    PUSHBUTTON      "NO",IDNO,137,73,50,14
    DEFPUSHBUTTON   "Cancel",IDCANCEL,211,73,50,14
    LTEXT           "message",IDC_MSG,27,9,226,41
    CONTROL         "Use as default setting, don't prompt any more",IDC_NO_PROMPT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,51,54,196,10
END

IDD_ERROR_RESOLVE DIALOG  0, 0, 300, 174
