IDM_MENU MENU 
BEGIN
    POPUP "normal"
    BEGIN
        MENUITEM "&Search Lyrics...\tD",        IDC_OPEN_LYRICS
        POPUP "&Lyrics"
        BEGIN
            POPUP "Ra&te These Lyrics"
            BEGIN
                MENUITEM "5 (High)",                    IDC_RATE_LYR_5
