// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MPLAYER             ICON                    "res\\Minilyrics.ico"
IDI_SAVE                ICON                    "res\\save.ico"
IDI_PLAY                ICON                    "Res\\play.ICO"
IDI_STOP                ICON                    "Res\\stop.ICO"
IDI_OPEN                ICON                    "Res\\open.ICO"
IDI_PREV                ICON                    "Res\\prev.ico"
IDI_NEXT                ICON                    "Res\\next.ICO"
IDI_CRASH               ICON                    "Res\\applicat.ico"
IDI_DRAGAFTER           ICON                    "Res\\dragafte.ico"
IDI_DRAGBEFORE          ICON                    "Res\\dragbefo.ico"
IDI_F_TXT               ICON                    "res\\icon-tga.ico"
IDI_F_LRC               ICON                    "res\\ico00001.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_LOGIN DIALOGEX 0, 0, 227, 119
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Login"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "Login Name:",IDC_STATIC,33,39,52,8
    EDITTEXT        IDC_E_USER,89,37,87,14,ES_AUTOHSCROLL
    LTEXT           "Password:",IDC_STATIC,33,58,52,8
    EDITTEXT        IDC_E_PWD,89,56,87,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "Remember password",IDC_C_REMBERPWD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,33,78,118,10
    DEFPUSHBUTTON   "OK",IDOK,24,98,50,14
    PUSHBUTTON      "Ignore",IDNO,88,98,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,152,98,50,14
    LTEXT           "Please login, so you could manage the uploaded lyrics.",IDC_STATIC,19,21,201,8
    LTEXT           "Thank you for uploading lyrics.",IDC_STATIC,19,7,126,8
    PUSHBUTTON      "Sign up Free",IDC_APPLY_ACCOUNT,153,78,50,14
END

IDD_UPLOAD_LRC DIALOG  0, 0, 420, 239
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Upload Lyrics"
FONT 8, "MS Shell Dlg"
BEGIN
    PUSHBUTTON      "Browse",IDC_BROWSE,310,7,50,14
    PUSHBUTTON      "Refresh",IDC_REFRESH,363,7,50,14
    CONTROL         "List1",IDC_LIST_FILES,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,26,406,122
    LTEXT           "File Name:",IDC_S_FILENAME,7,155,51,8
    EDITTEXT        IDC_E_FILENAME,62,153,351,14,ES_AUTOHSCROLL
    LTEXT           "Artist:",IDC_S_ARTIST,7,174,32,8
    EDITTEXT        IDC_E_ARTIST,62,171,151,14,ES_AUTOHSCROLL
    LTEXT           "Title:",IDC_S_TITLE,221,174,29,8
    EDITTEXT        IDC_E_TITLE,262,171,151,14,ES_AUTOHSCROLL
    LTEXT           "Album (Optional):",IDC_S_ALBUM,7,193,53,8
    EDITTEXT        IDC_E_ALBUM,62,190,151,14,ES_AUTOHSCROLL
    LTEXT           "Comment:",IDC_S_COMMENT,221,193,39,8,NOT WS_VISIBLE
    EDITTEXT        IDC_E_COMMENT,262,190,151,14,ES_AUTOHSCROLL | NOT WS_VISIBLE
    DEFPUSHBUTTON   "Upload",IDC_UPLOAD,95,218,50,14
    PUSHBUTTON      "Help",IDC_MLHELP,155,218,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,275,218,50,14
    LTEXT           "Directory:",IDC_STATIC,7,9,55,8
    EDITTEXT        IDC_E_DIR,70,7,236,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Edit",IDC_EDIT,215,218,50,14
END

IDD_UPLOAD_EXIST DIALOG  0, 0, 351, 151
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "$Product$"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "The lyrics exists on the server, your upload action doesn't take effect.",IDC_STATIC,8,10,296,8
    LTEXT           "Existed lyrics on the server:",IDC_STATIC,7,23,114,8
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,36,337,87
    DEFPUSHBUTTON   "OK",IDOK,147,130,50,14
END

IDD_MLSTART DIALOG  0, 0, 243, 191
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Restart $Product$"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,61,229,103
    DEFPUSHBUTTON   "OK",IDOK,60,170,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,138,170,50,14
    LTEXT           "If $Product$ was closed, please choose one of the listed items, and click OK to start $Product$.",IDC_STATIC,7,34,229,22
    LTEXT           "If no items are listed below, please run your player, and $Product$ window should show up automatically.",IDC_STATIC,7,7,229,22
END

IDD_COPYSONGLYRICS DIALOG  0, 0, 279, 111
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Copy song file and lyrics to..."
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Source file:",IDC_STATIC,7,11,49,8
    EDITTEXT        IDC_E_SRC,70,9,202,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Target folder:",IDC_STATIC,7,30,51,8
    EDITTEXT        IDC_E_TARGET,70,28,187,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,260,28,12,14
    CONTROL         "copy lyrics",IDC_C_COPYLYRICS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,49,113,10
    CONTROL         "rename lyrics as the same name as the song",IDC_C_RENAMELYRICS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,68,251,10
    DEFPUSHBUTTON   "OK",IDOK,75,90,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,154,90,50,14
END

IDD_NEW_VERSION_PROMPT DIALOGEX 0, 0, 281, 187
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New version notice"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "&Visit website",IDC_VISITWEB,50,166,78,14
    PUSHBUTTON      "&Close",IDCANCEL,152,166,78,14
    CTEXT           "New Version Notice",IDC_STATIC,66,6,117,8
    EDITTEXT        IDC_NEW_VERSION,7,24,267,133,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_NOHIDESEL | ES_READONLY | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
END

IDD_CRASH_REPORT DIALOGEX 0, 0, 268, 129
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "$Product$ Crash Report"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "$Product$ has encountered a problem and needs to close. We are sorry for the inconvenience.",IDC_STATIC,19,17,201,24
    DEFPUSHBUTTON   "&Send",IDOK,145,107,50,14
    PUSHBUTTON      "E&xit",IDCANCEL,211,107,50,14
    ICON            IDI_CRASH,IDC_STATIC,226,16,21,20,SS_REALSIZEIMAGE
    LTEXT           "We have created an error report that you can send to us.  We will treat this report as confidential and anonymous.",IDC_STATIC,20,45,230,20
    LTEXT           "Please click 'Send' button, a new mail will be generated, then send this mail to us. It will be very helpful to solve this error.",IDC_STATIC,20,70,230,33
END

IDD_MSG DIALOG  0, 0, 268, 85
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "$Product$"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Your messages here!",IDC_MSG,27,17,226,21
    CONTROL         "Use as default setting, don't prompt any more",IDC_NO_PROMPT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,51,45,196,10
    PUSHBUTTON      "YES",IDYES,100,64,50,14,NOT WS_VISIBLE
    PUSHBUTTON      "NO",IDNO,155,64,50,14,NOT WS_VISIBLE
    DEFPUSHBUTTON   "Cancel",IDCANCEL,210,64,50,14,NOT WS_VISIBLE
    PUSHBUTTON      "OK",IDOK,100,64,50,14,NOT WS_VISIBLE
END

IDD_ERROR_RESOLVE DIALOG  0, 0, 300, 174
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "$Product$"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Your messages here!",IDC_ERROR,27,11,238,36
    LTEXT           "How to solve the problem?",IDC_STATIC,7,52,139,8
    LTEXT           "How to solve the problem?",IDC_RESOLVE,27,67,238,81
    PUSHBUTTON      "Copy To Clipboard",IDC_COPYTOCLIPBOARD,7,153,65,14
    PUSHBUTTON      "Setup Connection",IDC_SETUP_INET,80,153,65,14
    PUSHBUTTON      "Help",IDC_ML_HELP,153,153,65,14
    PUSHBUTTON      "Report Bug?",IDC_REPORT,226,153,65,14
END

IDD_WAITING DIALOGEX 0, 0, 253, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Searching Lyrics"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,90,45,73,14,WS_DISABLED
    LTEXT           "$Product$ is searching lyrics now, it may take a few seconds.",IDC_MSG,11,13,235,24
END

IDD_SEL_ENCODING DIALOGEX 0, 0, 293, 161
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Advanced Save Options"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "&Encoding:",IDC_STATIC,7,10,55,10
    COMBOBOX        IDC_CB_ENCODING,71,10,215,245,CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_E_SAMPLE,7,29,279,105,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "OK",IDOK,169,140,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,236,140,50,14
END

IDD_RATE_LYR DIALOGEX 0, 0, 203, 90
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rate these lyrics"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "rating:",IDC_STATIC1,7,8,55,8
    PUSHBUTTON      "Rate!",IDOK,72,70,58,14,BS_CENTER
    COMBOBOX        IDC_CB_RATING,65,7,130,93,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Hide the link of rating lyrics",IDC_HIDE_RATE_LINK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,29,162,10
    LTEXT           "$Product$ will open a web page to submit the rating result.",IDC_STATIC,7,42,188,24
END

IDD_BATCH_EMBEDDED_LYR DIALOG  0, 0, 384, 228
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Batch process embedded lyrics"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,2,369,200
    DEFPUSHBUTTON   "Process All",IDOK,128,207,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,204,207,50,14
    PUSHBUTTON      "Add More...",IDC_ADD_SONG_FILE,7,207,50,14,NOT WS_VISIBLE
END

IDD_SET_HOTKEY DIALOGEX 0, 0, 191, 75
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shortcut"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    EDITTEXT        IDC_HOTKEY,6,29,178,14,ES_AUTOHSCROLL
    PUSHBUTTON      "OK",IDOK,37,54,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,104,54,50,14
    LTEXT           "Press shortcut keys:",IDC_STATIC,6,11,178,12
END


