IDM_LYR_EDITOR MENU 
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "&Upload Lyrics..."
        BEGIN
            MENUITEM "&Upload Lyrics...",           IDC_UPLOAD_LYRICS
            MENUITEM "Sign &in...",                 IDC_LOGIN
            MENUITEM "Sign in Via &Web Browser...", IDC_LOGIN_VIA_IE
            MENUITEM "&Sign up Free...",            IDC_APPLY_ACCOUNT
        END
        MENUITEM SEPARATOR
        MENUITEM "Open &Lyrics...\tCtrl+L",     IDC_OPEN_LYRICS
        MENUITEM "Save Lyrics in &Mp3 file",    IDC_SAVE_LYRICS_TO_MP3
        MENUITEM "&Remove Lyrics in Mp3 File",  IDC_REMOVE_LRC_IN_MP3
        MENUITEM SEPARATOR
        MENUITEM "&Save Lyrics\tCtrl+S",        IDC_SAVE_LYRICS
        MENUITEM "Save Lyrics &As...",          IDC_SAVE_LYRICS_AS
        MENUITEM "&Advanced Save Lyrics Options...", IDC_ADVANCED_SAVE_LYR
