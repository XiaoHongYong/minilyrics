            MENUITEM SEPARATOR
            MENUITEM "Baltic",                      IDC_ENC_BALTIC
            MENUITEM SEPARATOR
            MENUITEM "Cyrillic",                    IDC_ENC_CYRILLIC
            MENUITEM SEPARATOR
            MENUITEM "Central European",            IDC_ENC_CENTRAL_EUROPE
            MENUITEM SEPARATOR
            MENUITEM "Western European",            IDC_ENC_WEST_EUROPE
            MENUITEM SEPARATOR
            MENUITEM "Greek",                       IDC_ENC_GREEK
            MENUITEM SEPARATOR
            MENUITEM "Hebrew",                      IDC_ENC_HEBREW
            MENUITEM SEPARATOR
            MENUITEM "&Japanese",                   IDC_ENC_JAPANESE
            MENUITEM SEPARATOR
            MENUITEM "&Korean",                     IDC_ENC_KOREAN
            MENUITEM SEPARATOR
            MENUITEM "Latin 9 (ISO)",               IDC_ENC_LATIN9_ISO
            MENUITEM SEPARATOR
            MENUITEM "&Simplified Chinese (GB)",    IDC_ENC_CHS
            MENUITEM "&Traditional Chinese (Big5)", IDC_ENC_CHT
            MENUITEM SEPARATOR
            MENUITEM "Thai",                        IDC_ENC_THAI
            MENUITEM SEPARATOR
            MENUITEM "Turkish",                     IDC_ENC_TURKISH
            MENUITEM SEPARATOR
            MENUITEM "&Unicode",                    IDC_ENC_UNICODE
            MENUITEM "Utf-&8",                      IDC_ENC_UTF8
            MENUITEM SEPARATOR
            MENUITEM "Vietnamese",                  IDC_ENC_VIETNAMESE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      IDC_CLOSE
    END
    POPUP "&Play"
    BEGIN
        MENUITEM "&Play/Pause",                 IDC_PLAYPAUSE
        MENUITEM "&Stop",                       IDC_STOP
        MENUITEM SEPARATOR
        MENUITEM "Pr&evious",                   IDC_PREV
        MENUITEM "&Next",                       IDC_NEXT
        MENUITEM SEPARATOR
        MENUITEM "&Backward 2 Seconds\tCtrl+Page up", IDC_BACKWARD2SEC
        MENUITEM "&Forward 2 Seconds\tCtrl+Page down", IDC_FORWARD2SEC
        MENUITEM "Jump to current line\tCtrl+J", IDC_JUMP_TO_CURRENT_LINE
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               IDC_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",               IDC_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                IDC_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               IDC_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              IDC_EDIT_PASTE
        MENUITEM "&Delete\tDel",                IDC_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            IDC_EDIT_FIND
        MENUITEM "&Replace...\tCtrl+H",         IDC_EDIT_REPLACE
    END
    POPUP "&Lyrics"
    BEGIN
        MENUITEM "Synchronize the current line and move to next line\tF7", IDC_INSERT_TAG_AND_MOVE_DOWN
        MENUITEM "Synchronize the current line\tCtrl+F7", IDC_INSERT_TAG
        MENUITEM SEPARATOR
        MENUITEM "Auto fill artist, album and title info", IDC_AUTO_FILL_LYRICS_INFO
        MENUITEM SEPARATOR
        MENUITEM "Forward the timestamp of this line 0.2s\tCtrl+'+'", IDC_FORWARD_CUR_LINE
        MENUITEM "Backward the timestamp of this line 0.2s\tCtrl+'-'", IDC_BACKWARD_CUR_LINE
        MENUITEM SEPARATOR
        MENUITEM "Forward the remaining lyrics 0.2s", IDC_FORWARD_REMAIN_LINES
        MENUITEM "Backward the remaining lyrics 0.2s", IDC_BACKWARD_REMAIN_LINES
        MENUITEM SEPARATOR
        MENUITEM "Trim Leading and Trailing Whitespace of All Lines", IDC_TRIM_SPACE
        MENUITEM "Remove All Timestamps",       IDC_REMOVE_ALL_TAG
        MENUITEM "Remove All Blank Lines",      IDC_REMOVE_BLANK_LINE
        MENUITEM "Remove All Unsynchronized Lines", IDC_REMOVE_UNSYNC_LINE
        MENUITEM SEPARATOR
        MENUITEM "Capitalize the Leading Letter of All Lines", IDC_CAPITALIZE_LEADING_LETTER
        MENUITEM "Convert All Lyrics Characters to Lower Case", IDC_TO_LOWER_CASE
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Tag Color...",               IDC_TAG_COLOR
        MENUITEM "&Background Color of Edited Line...", IDC_EDIT_LINE_COLOR
        MENUITEM SEPARATOR
        MENUITEM "&Preferences...",             IDC_LYR_DISPLAY_OPT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "A&bout $Product$...",         IDC_ABOUT
        MENUITEM "$Product$ &Help",             IDC_ML_HELP
        MENUITEM SEPARATOR
        MENUITEM "$Product$ &Website",          IDC_WEBHOME
        MENUITEM "&Report to Author",           IDC_EMAIL
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MPLAYER             ICON                    "res\\mplayer.ico"
IDI_SAVE                ICON                    "res\\save.ico"
IDI_MEDIATYPE2          ICON                    "Res\\mediatype2.ico"
IDI_PLAY                ICON                    "Res\\play.ICO"
IDI_STOP                ICON                    "Res\\stop.ICO"
IDI_OPEN                ICON                    "Res\\open.ICO"
IDI_PREV                ICON                    "Res\\prev.ico"
IDI_NEXT                ICON                    "Res\\next.ICO"
IDI_CRASH               ICON                    "Res\\applicat.ico"
IDI_DRAGAFTER           ICON                    "Res\\dragafte.ico"
IDI_DRAGBEFORE          ICON                    "Res\\dragbefo.ico"
IDI_F_TXT               ICON                    "res\\icon-tga.ico"
IDI_F_LRC               ICON                    "res\\ico00001.ico"

